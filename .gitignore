# --- Gradle / Android build outputs ---
.gradle/
build/
captures/
.cxx/
.externalNativeBuild/
*.apk
*.aab

# --- Machine-specific ---
local.properties

# --- NDK build intermediates (regenerated from service/jni) ---
service/obj/
service/temp/

# --- Duplicate prebuilt native libs (canonical copy lives in service/jniLibs) ---
service/libs/

# --- 预编译 .so 的本地备份（重编前留档，便于回滚；不入库） ---
.so_backup_*/

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.classpath
.project

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Python / misc ---
__pycache__/
*.pyc
temp/

# --- Editor backups ---
*.bak*

# --- NDK build output ---
service/jni/obj/
**/jni/obj/

# liblouis host-side test artifact (not part of the app)
.lou_host_test/

# --- 本地逆向分析工作区（固件与反编译产物，约 1.2 GB，不入库） ---
_re/

# --- Kotlin 编译缓存 ---
.kotlin/

# --- 误产生的空文件（PowerShell 重定向残留） ---
$null
