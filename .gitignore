# --- Gradle / Android build outputs ---
.gradle/
build/
captures/
.cxx/
.externalNativeBuild/
*.apk
*.aab

# --- Machine-specific ---
local.properties

# --- NDK build intermediates (regenerated from service/jni) ---
service/obj/
service/temp/

# --- Duplicate prebuilt native libs (canonical copy lives in service/jniLibs) ---
service/libs/

# --- 预编译 .so 的本地备份（重编前留档，便于回滚；不入库） ---
.so_backup_*/

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.classpath
.project

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Python / misc ---
__pycache__/
*.pyc
temp/

# --- Editor backups ---
*.bak*

# --- NDK build output ---
service/jni/obj/
**/jni/obj/

# liblouis host-side test artifact (not part of the app)
.lou_host_test/

# --- 本地逆向分析工作区（固件与反编译产物，约 1.2 GB，不入库） ---
_re/

# --- Kotlin 编译缓存 ---
.kotlin/

# --- 误产生的空文件（PowerShell 重定向残留） ---
$null

# --- 本地诊断/调试产物（只忽略，不删除、不移动；文件在工作区保持原样） ---
# 注：仓库已有 addon/ 与 service/res/raw/ 下的 .zip 资源包并已跟踪，
# 所以这里只点名本地驱动资料包，不能用 *.zip 通配。
.tmp-*
日志五-*.txt
/清华点显器驱动.zip
/driver_cp210x/
service/jni/brlttywrapper/third_party/brltty_backup_*/
# service/jniLibs 是唯一入库的预编译 .so 副本；jni/ 下这份是本地编译产物
service/jni/jniLibs/
tools/_so_check/
tools/*.dll
# --- 正式签名密钥（本机私有，绝不入库） ---
keystore.properties
*.jks
*.keystore
