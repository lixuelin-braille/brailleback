    <string name="overlay_tutorial_title" msgid="323686269924134028">"叠加层教程"</string>
    <string name="overlay_tutorial_finish_button" msgid="8190984135613253372">"完成"</string>
    <string name="overlay_tutorial_introduction" msgid="732693451088628629">"盲文叠加层能模拟可刷新的盲文显示屏，并可将盲文单元格以及相应的文本显示在硬件显示屏上。我们建议您先启用 TalkBack 和触摸浏览模式，然后再继续使用该功能。"</string>
    <string name="overlay_tutorial_accessibility_settings_button" msgid="7614097829221431291">"无障碍设置"</string>
    <string name="overlay_tutorial_pan" msgid="6845897761664313491">"您可以通过按文本旁边的某个平移按钮，平移盲文显示屏。"</string>
    <string name="overlay_tutorial_routing_keys" msgid="4226607385598426316">"显示屏上可能会一次显示多个元素。您可以通过点按文本中的某个盲文单元格，点击其中一个元素。此操作相当于按盲文显示屏上的某个路选键。"</string>
    <string name="overlay_tutorial_moving" msgid="6583235883700027279">"如果叠加层覆盖了屏幕上的其他元素，那么您可以将其移开。长按叠加层，然后拖动。当您松开手指时，该叠加层将对准屏幕顶部或底部。"</string>
    <string name="overlay_tutorial_dialog_title" msgid="4114032130535945266">"显示叠加层教程"</string>
    <string name="overlay_tutorial_dialog_message" msgid="8623281534692086379">"我们建议您在使用屏幕叠加层功能之前先查看相关教程。"</string>
    <string name="search_result_prefix" msgid="404457595813397708">"搜到："</string>
    <string name="search_dialog_label" msgid="1816668691365362442">"搜索：<xliff:g id="SEARCH_QUERY">%1$s</xliff:g>"</string>
    <string name="search_tutorial_title" msgid="1035979397405903476">"“在屏幕上搜索”教程"</string>
    <string name="search_tutorial_instructions_general" msgid="6818519646574055310">"在屏幕上搜索可让您通过输入部分文字说明，快速跳转至屏幕上相应的内容。在您输入文字说明时，焦点会自动移至下一个匹配的内容。"</string>
    <string name="search_tutorial_instructions_specific" msgid="6238171239009571192">"使用 <xliff:g id="NEXT_KEY_COMMAND">%1$s</xliff:g> 可移至下一个结果，使用 <xliff:g id="PREVIOUS_KEY_COMMAND">%2$s</xliff:g> 可移至上一个结果。按 <xliff:g id="ENTER_KEY_COMMAND">%3$s</xliff:g> 可退出搜索模式并使焦点保留在搜索结果上。按 <xliff:g id="TOGGLE_SEARCH_KEY_COMMAND">%4$s</xliff:g> 可返回到上一个焦点内容。"</string>
