<!-- App version is injected by AGP from root gradle.properties
     (appVersionCode / appVersionName). Do not declare it here again. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.linxi.brailleback">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 视口平移到边界时的短震反馈；无震动马达 / 权限被拒时静默降级，不影响浏览。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Foreground service keeps the braille display connection alive when
         the accessibility service would otherwise be idle-processed away.
         connectedDevice matches our use case (external braille displays). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required on API 33+ for the foreground-service notification to be
         visible. Without it the FGS still runs; only the notification is
         hidden (it remains in Task Manager). Requested at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 保活自检页要用 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 直接弹系统确认框；
         侧载自用，不上架，不涉及应用商店对该权限的限制。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ requires BLUETOOTH_CONNECT to enumerate and connect to
         bonded braille displays. BLUETOOTH_SCAN is only used for short,
         bounded discovery windows so a display that has just been switched
         on can be found without polling the radio forever. The scan result is
         never used to derive location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="com.googlecode.eyesfree.braille.display.PERMISSION_CONNECT" />

    <!-- Overlays are rendered as TYPE_ACCESSIBILITY_OVERLAY inside the
         accessibility service, which does not require SYSTEM_ALERT_WINDOW.
         The minSdk (23) is above the TYPE_SYSTEM_ERROR fallback path, so this
         permission was redundant and has been removed. -->

    <!-- Required for reading/writing custom view labels. -->
    <uses-permission android:name="com.google.android.marvin.talkback.permission.LABELING" />

    <permission
        android:name="com.googlecode.eyesfree.braille.display.PERMISSION_CONNECT"
        android:icon="@drawable/ic_brailleback"
        android:label="@string/permlab_displayConnect"
        android:description="@string/permdesc_displayConnect"
        android:protectionLevel="signature" />

    <!-- Self-braille is an exported AIDL service for companion accessibility
         apps. Only apps signed with the same key may bind to it. -->
    <permission
        android:name="com.googlecode.eyesfree.braille.selfbraille.PERMISSION_WRITE"
        android:protectionLevel="signature" />

    <!-- Hardware compatibility. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Wired braille displays are optional; declaring USB host lets the
         system deliver ACTION_USB_DEVICE_ATTACHED and lets UsbManager
         enumerate OTG devices. required=false keeps Bluetooth-only installs
         working on devices without USB host support. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- 移植的屏幕盲文键盘用系统 TTS 播报按键反馈。
         Android 11+ 的包可见性限制要求显式声明，否则 TextToSpeech 找不到引擎，
         表现为"键盘能用但完全没有语音"。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/brailleback_setup_title"
        android:icon="@drawable/ic_brailleback"
        android:theme="@style/BraillebackTheme"
        tools:replace="android:icon, android:label"
        android:supportsRtl="true">

        <service android:name=".BrailleBackService"
                 android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
                 android:settingsActivity=".HomeContainerActivity"
                 android:foregroundServiceType="connectedDevice"
                 android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibilityservice" />
        </service>

        <!--
            唯一注册的盲文输入法：点显器硬件按键与触屏点字键盘共用本服务。
            移植键盘 BrailleIme 不再单独注册（见 addon/brailleime/AndroidManifest.xml），
            其实现由 BrailleIME 继承复用，形态由 pref_single_ime_view_mode 决定。
            meta-data 沿用移植键盘的 braille_ime.xml，保留设置页入口与
            supportsSwitchingToNextInputMethod，避免合并后设置页与切换键丢失。
        -->
        <service
            android:name=".BrailleIME"
            android:label="@string/bb_port_ime_service_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/braille_ime" />
        </service>

        <service
            android:name="com.googlecode.eyesfree.braille.service.display.DisplayService"
            android:permission="com.googlecode.eyesfree.braille.display.PERMISSION_CONNECT"
            android:foregroundServiceType="connectedDevice"
            android:exported="false">
            <intent-filter>
                <action android:name="com.googlecode.eyesfree.braille.service.ACTION_DISPLAY_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".SelfBrailleService"
            android:permission="com.googlecode.eyesfree.braille.selfbraille.PERMISSION_WRITE"
            android:exported="true">
            <intent-filter>
                <action android:name="com.googlecode.eyesfree.braille.service.ACTION_SELF_BRAILLE_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name="com.googlecode.eyesfree.braille.service.translate.TranslatorService"
            android:exported="false"
            android:process=":service">
            <intent-filter>
                <action android:name="com.googlecode.eyesfree.braille.service.ACTION_TRANSLATOR_SERVICE" />
            </intent-filter>
        </service>

        <!-- 主屏容器：底部导航（书籍阅读管理 / 设置）。桌面入口 + 无障碍服务设置入口。 -->
        <activity
            android:name=".HomeContainerActivity"
            android:label="@string/brailleback_setup_title"
            android:icon="@drawable/ic_brailleback"
            android:theme="@style/BraillebackSettingsTheme"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.accessibilityservice.SERVICE_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 兼容别名：保留类名供子屏返回与旧链接使用，进入后转跳 HomeContainerActivity。 -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/brailleback_setup_title"
            android:icon="@drawable/ic_brailleback"
            android:theme="@style/BraillebackSettingsTheme"
            android:launchMode="singleTop"
            android:exported="true" />

        <activity
            android:name=".BrailleReaderActivity"
            android:label="@string/pref_braille_reader_title"
            android:exported="false" />

        <activity
            android:name=".BookshelfActivity"
            android:label="@string/bookshelf_title"
            android:exported="false" />

        <activity
            android:name=".KeyBindingsActivity"
            android:title="@string/key_bindings_title"
            tools:ignore="ManifestResource"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 盲文显示器按键自定义：默认全部保持原动作，修改后立即生效 -->
        <activity
            android:name=".CustomKeyMapActivity"
            android:label="@string/custom_key_map_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="false" />

        <!-- Jetpack Compose 分批迁移：设备与连接（第一批）、按键与手势（第二批）、
             盲文显示（第三批）、声音与行为（第四批）、开发者选项（第五批）。
             五个子屏现已全部由独立 Activity 渲染；五个子屏的旧 XML 定义
             全部保留，随时可回退。 -->
        <activity
            android:name=".compose.DeviceConnectionComposeActivity"
            android:label="@string/pref_category_device_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="false" />

        <activity
            android:name=".compose.KeysGesturesComposeActivity"
            android:label="@string/pref_category_keys_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="false" />

        <activity
            android:name=".compose.BrailleDisplayComposeActivity"
            android:label="@string/pref_category_braille_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="false" />

        <activity
            android:name=".compose.SoundBehaviorComposeActivity"
            android:label="@string/pref_category_sound_behavior_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="false" />

        <activity
            android:name=".compose.DeveloperOptionsComposeActivity"
            android:label="@string/pref_category_developer_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="false" />

    <activity
        android:name=".compose.StabilityComposeActivity"
        android:label="@string/pref_category_stability_title"
        android:theme="@style/BraillebackSettingsTheme"
        android:exported="false" />

        <!-- 实验功能：触觉图导出。独立 launcher 入口（应用列表图标直达），
             图标沿用应用默认图标。TactileExperiment 仅作为将来是否接进设置主屏的标志，
             不阻断本页流程。 -->
        <activity
            android:name=".tactile.TactileExportActivity"
            android:label="@string/tactile_export_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 点显图片：选入图片后分页直送连着的盲文点显器；书架页内进入，不对外导出。 -->
        <activity
            android:name=".tactile.TactileStripActivity"
            android:label="@string/tactile_strip_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="false" />

        <!-- 数学公式转盲文：书架页内进入；只接 MathML / 受控线性文本，不做公式 OCR。 -->
        <activity
            android:name=".math.MathBrailleActivity"
            android:label="@string/math_title"
            android:theme="@style/BraillebackSettingsTheme"
            android:exported="false" />

        <activity
             android:name=".IMESetupWizardActivity"
             android:label="@string/ime_setup_wizard_name"
             android:theme="@android:style/Theme.Holo.Dialog"
             android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OverlayTutorialActivity"
            android:label="@string/overlay_tutorial_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- No intent-filter, so exported defaults to false. Stated explicitly
             to make the intent non-exported-by-design, and to avoid forgetting
             it should an intent-filter ever be added here. -->
        <activity android:name="WebViewDialog" android:exported="false" />

        <activity
            android:name=".SearchTutorialActivity"
            android:title="@string/search_tutorial_title"
            tools:ignore="ManifestResource"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
</application>
</manifest>

