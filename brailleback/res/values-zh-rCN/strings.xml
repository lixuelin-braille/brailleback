    <string name="search_tutorial_title" msgid="1035979397405903476">"“在屏幕上搜索”教程"</string>
    <string name="search_tutorial_instructions_general" msgid="6818519646574055310">"在屏幕上搜索可让您通过输入部分文字说明，快速跳转至屏幕上相应的内容。在您输入文字说明时，焦点会自动移至下一个匹配的内容。"</string>
    <string name="search_tutorial_instructions_specific" msgid="6238171239009571192">"使用 <xliff:g id="NEXT_KEY_COMMAND">%1$s</xliff:g> 可移至下一个结果，使用 <xliff:g id="PREVIOUS_KEY_COMMAND">%2$s</xliff:g> 可移至上一个结果。按 <xliff:g id="ENTER_KEY_COMMAND">%3$s</xliff:g> 可退出搜索模式并使焦点保留在搜索结果上。按 <xliff:g id="TOGGLE_SEARCH_KEY_COMMAND">%4$s</xliff:g> 可返回到上一个焦点内容。"</string>
