<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" >

    <PreferenceCategory
         android:key="@string/pref_category_device_key"
         android:title="@string/pref_category_device_title" >
        <Preference
             android:key="@string/pref_connection_status_key"
             android:title="@string/pref_connection_status_title" />
        <Preference
             android:key="@string/pref_key_bindings_key"
             android:title="@string/pref_key_bindings_title" />
        <ListPreference
             android:key="@string/pref_connection_protocol_key"
             android:title="@string/pref_connection_protocol_title"
             android:summary="%1$s"
             android:defaultValue="@string/pref_connection_protocol_default"
             android:entries="@array/pref_connection_protocol_entries"
             android:entryValues="@array/pref_connection_protocol_values" />
    </PreferenceCategory>

    <PreferenceCategory
         android:key="@string/pref_category_braille_key"
         android:title="@string/pref_category_braille_title" >
        <ListPreference
             android:key="@string/pref_braille_type_key"
             android:title="@string/pref_braille_type_title"
             android:summary="%1$s"
             android:defaultValue="@string/pref_braille_type_default"
             android:entries="@array/pref_braille_type_entries"
             android:entryValues="@array/pref_braille_type_values" />

        <!-- android:summary is not used here because the entry values are
             populated by a service. If the service responds slowly (e.g.
             because it is not yet running), %s would be displayed instead.
             Instead, setSummary is called explicitly in onTablesChanged. -->
        <ListPreference
             android:key="@string/pref_six_dot_braille_table_key"
             android:title="@string/pref_six_dot_braille_table_title"
             android:defaultValue="@string/table_value_default" />
        <ListPreference
             android:key="@string/pref_eight_dot_braille_table_key"
             android:title="@string/pref_eight_dot_braille_table_title"
             android:defaultValue="@string/table_value_default" />
        <ListPreference
             android:key="@string/pref_volume_long_press_up_key"
             android:title="@string/pref_volume_long_press_up_title"
             android:entries="@array/pref_volume_action_entries"
             android:entryValues="@array/pref_volume_action_values"
             android:defaultValue="@string/pref_volume_action_pause_value" />
        <ListPreference
             android:key="@string/pref_volume_long_press_down_key"
             android:title="@string/pref_volume_long_press_down_title"
             android:entries="@array/pref_volume_action_entries"
             android:entryValues="@array/pref_volume_action_values"
             android:defaultValue="@string/pref_volume_action_none_value" />
        <ListPreference
             android:key="@string/pref_volume_double_press_key"
             android:title="@string/pref_volume_double_press_title"
             android:entries="@array/pref_volume_action_entries"
             android:entryValues="@array/pref_volume_action_values"
             android:defaultValue="@string/pref_volume_action_grade_value" />
        <ListPreference
             android:key="@string/pref_pause_behavior_key"
             android:title="@string/pref_pause_behavior_title"
             android:entries="@array/pref_pause_behavior_entries"
             android:entryValues="@array/pref_pause_behavior_values"
             android:defaultValue="@string/pref_pause_behavior_clear_value" />
        <ListPreference
             android:key="@string/pref_idle_clear_key"
             android:title="@string/pref_idle_clear_title"
             android:entries="@array/pref_idle_clear_entries"
             android:entryValues="@array/pref_idle_clear_values"
             android:defaultValue="@string/pref_idle_clear_3min_value" />
        <CheckBoxPreference
             android:key="@string/pref_motion_mode_key"
             android:title="@string/pref_motion_mode_title"
             android:summaryOn="@string/pref_motion_mode_summary_on"
             android:summaryOff="@string/pref_motion_mode_summary_off"
             android:defaultValue="false" />
        <CheckBoxPreference
             android:key="@string/pref_braille_contracted_mode_key"
             android:title="@string/pref_braille_contracted_mode_title"
             android:summaryOn="@string/pref_braille_contracted_mode_summary_on"
             android:summaryOff="@string/pref_braille_contracted_mode_summary_off"
             android:defaultValue="false" />
        <SwitchPreference
             android:key="@string/pref_braille_word_wrap_key"
             android:title="@string/pref_braille_word_wrap_title"
             android:defaultValue="@bool/pref_braille_word_wrap_default" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="@string/pref_category_miscellaneous_key"
        android:title="@string/pref_category_miscellaneous_title">

        <Preference
            android:key="@string/pref_os_license_key"
            android:title="@string/pref_os_license_title"/>

        <PreferenceScreen
            android:key="@string/pref_category_developer_key"
            android:title="@string/pref_category_developer_title">

            <!-- Forced to VERBOSE in debug builds. -->
            <ListPreference
                android:defaultValue="@string/pref_log_level_default"
                android:dialogTitle="@string/pref_log_level_label"
                android:entries="@array/pref_log_level_entries"
                android:entryValues="@array/pref_log_level_values"
                android:key="@string/pref_log_level_key"
                android:summary="%s"
                android:title="@string/pref_log_level_label" />

            <PreferenceCategory
                android:key="@string/pref_category_braille_overlay_key"
                android:title="@string/pref_category_braille_overlay_title">
                <CheckBoxPreference
                    android:key="@string/pref_braille_overlay_key"
                    android:title="@string/pref_braille_overlay_title"
                    android:defaultValue="@bool/pref_braille_overlay_default" />
                <Preference
                    android:key="@string/pref_braille_overlay_tutorial_key"
                    android:title="@string/pref_braille_overlay_tutorial_title"
                    android:dependency="@string/pref_braille_overlay_key" />
            </PreferenceCategory>

        </PreferenceScreen>
    </PreferenceCategory>
    <PreferenceCategory
         android:key="pref_category_sound"
         android:title="@string/pref_sound_category_title" >
        <SwitchPreference
             android:key="@string/pref_sound_enabled_key"
             android:title="@string/pref_sound_enabled_title"
             android:summaryOn="@string/pref_sound_enabled_summary_on"
             android:summaryOff="@string/pref_sound_enabled_summary_off"
             android:defaultValue="true" />
        <Preference
             android:key="@string/pref_sound_volume_key"
             android:title="@string/pref_sound_volume_title"
             android:summary="@string/pref_sound_volume_summary" />
        <ListPreference
             android:key="@string/pref_sound_scheme_key"
             android:title="@string/pref_sound_scheme_title"
             android:summary="@string/pref_sound_scheme_summary" />
        <Preference
             android:key="@string/pref_sound_create_key"
             android:title="@string/pref_sound_create_title"
             android:summary="@string/pref_sound_create_summary" />
        <Preference
             android:key="@string/pref_sound_editor_key"
             android:title="@string/pref_sound_editor_title"
             android:summary="@string/pref_sound_editor_summary" />
        <Preference
             android:key="@string/pref_sound_reset_key"
             android:title="@string/pref_sound_reset_title"
             android:summary="@string/pref_sound_reset_summary" />
    </PreferenceCategory>
</PreferenceScreen>

