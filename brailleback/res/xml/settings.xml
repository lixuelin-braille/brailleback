<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页（androidx.preference 全量）：设备与连接 / 盲文显示 / 声音 / 高级。
    老框架设置页（BrailleBackPreferencesActivity）已退役。
    数据层共用同一个 SharedPreferences（key 与迁移前完全一致）。
-->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 启用服务引导（受限设置引导）：服务未启用时显示引导，点击跳系统无障碍设置 -->
    <Preference
        app:key="@string/pref_setup_service_key"
        app:title="@string/pref_setup_service_title"
        app:summary="@string/pref_setup_service_summary" />

    <Preference
        app:key="@string/pref_bookshelf_key"
        app:title="@string/pref_bookshelf_title"
        app:summary="@string/pref_bookshelf_summary" />

    <!-- 屏幕盲文键盘（移植自 TalkBack）：点击进入键盘设置页 -->
    <Preference
        app:key="pref_braille_keyboard_key"
        app:title="@string/pref_braille_keyboard_title"
        app:summary="@string/pref_braille_keyboard_summary" />

    <!-- 分类入口 1：设备与连接 -->
    <PreferenceScreen
        app:key="@string/pref_category_device_key"
        app:title="@string/pref_category_device_title"
        app:summary="@string/pref_category_device_summary">

        <Preference
            app:key="@string/pref_connection_status_key"
            app:title="@string/pref_connection_status_title" />
        <Preference
            app:key="@string/pref_key_bindings_key"
            app:title="@string/pref_key_bindings_title" />
        <ListPreference
            app:key="@string/pref_connection_protocol_key"
            app:title="@string/pref_connection_protocol_title"
            app:summary="%s"
            app:defaultValue="@string/pref_connection_protocol_default"
            app:entries="@array/pref_connection_protocol_entries"
            app:entryValues="@array/pref_connection_protocol_values" />
        <SwitchPreferenceCompat
            app:key="@string/pref_auto_connect_key"
            app:title="@string/pref_auto_connect_title"
            app:summary="@string/pref_auto_connect_summary"
            app:defaultValue="@bool/pref_auto_connect_default" />

    </PreferenceScreen>

    <!-- 分类入口 2：盲文显示 -->
    <PreferenceScreen
        app:key="@string/pref_category_braille_key"
        app:title="@string/pref_category_braille_title"
        app:summary="@string/pref_category_braille_summary">

        <PreferenceCategory
            app:key="@string/pref_category_braille_type_key"
            app:title="@string/pref_category_braille_type_title">

            <!-- 盲文表的条目由服务动态填充（见 SettingsActivity.addTableList），
                 不在 XML 里写 entries/summary，避免服务未就绪时显示 %s 占位。
                 六点表与八点（计算机）表合并成一个列表，不再单独设置“计算机盲文”。 -->
            <ListPreference
                app:key="@string/pref_braille_table_key"
                app:title="@string/pref_braille_table_title"
                app:defaultValue="@string/table_value_default" />

            <SwitchPreferenceCompat
                app:key="@string/pref_braille_word_wrap_key"
                app:title="@string/pref_braille_word_wrap_title"
                app:defaultValue="@bool/pref_braille_word_wrap_default" />

            <SwitchPreferenceCompat
                app:key="@string/pref_cursor_dots_key"
                app:title="@string/pref_cursor_dots_title"
                app:summaryOn="@string/pref_cursor_dots_summary_on"
                app:summaryOff="@string/pref_cursor_dots_summary_off"
                app:defaultValue="false" />

            <CheckBoxPreference
                app:key="@string/pref_braille_contracted_mode_key"
                app:title="@string/pref_braille_contracted_mode_title"
                app:summaryOn="@string/pref_braille_contracted_mode_summary_on"
                app:summaryOff="@string/pref_braille_contracted_mode_summary_off"
                app:defaultValue="false" />

            <SwitchPreferenceCompat
                app:key="@string/pref_chinese_segmentation_key"
                app:title="@string/pref_chinese_segmentation_title"
                app:summary="@string/pref_chinese_segmentation_summary"
                app:defaultValue="@bool/pref_chinese_segmentation_default" />

        </PreferenceCategory>

        <PreferenceCategory
            app:key="@string/pref_category_volume_key"
            app:title="@string/pref_category_volume_title">

            <SwitchPreferenceCompat
                app:key="@string/pref_volume_gestures_enabled_key"
                app:title="@string/pref_volume_gestures_enabled_title"
                app:summaryOn="@string/pref_volume_gestures_enabled_summary_on"
                app:summaryOff="@string/pref_volume_gestures_enabled_summary_off"
                app:defaultValue="@bool/pref_volume_gestures_enabled_default" />

            <ListPreference
                app:key="@string/pref_volume_long_press_up_key"
                app:title="@string/pref_volume_long_press_up_title"
                app:summary="%s"
                app:entries="@array/pref_volume_action_entries"
                app:entryValues="@array/pref_volume_action_values"
                app:defaultValue="@string/pref_volume_action_pause_value" />

            <ListPreference
                app:key="@string/pref_volume_long_press_down_key"
                app:title="@string/pref_volume_long_press_down_title"
                app:summary="%s"
                app:entries="@array/pref_volume_action_entries"
                app:entryValues="@array/pref_volume_action_values"
                app:defaultValue="@string/pref_volume_action_none_value" />

            <ListPreference
                app:key="@string/pref_volume_double_press_key"
                app:title="@string/pref_volume_double_press_title"
                app:summary="%s"
                app:entries="@array/pref_volume_action_entries"
                app:entryValues="@array/pref_volume_action_values"
                app:defaultValue="@string/pref_volume_action_grade_value" />

        </PreferenceCategory>

        <PreferenceCategory
            app:key="@string/pref_category_behavior_key"
            app:title="@string/pref_category_behavior_title">

            <ListPreference
                app:key="@string/pref_pause_behavior_key"
                app:title="@string/pref_pause_behavior_title"
                app:summary="%s"
                app:entries="@array/pref_pause_behavior_entries"
                app:entryValues="@array/pref_pause_behavior_values"
                app:defaultValue="@string/pref_pause_behavior_clear_value" />

            <ListPreference
                app:key="@string/pref_idle_clear_key"
                app:title="@string/pref_idle_clear_title"
                app:summary="%s"
                app:entries="@array/pref_idle_clear_entries"
                app:entryValues="@array/pref_idle_clear_values"
                app:defaultValue="@string/pref_idle_clear_3min_value" />

            <CheckBoxPreference
                app:key="@string/pref_motion_mode_key"
                app:title="@string/pref_motion_mode_title"
                app:summaryOn="@string/pref_motion_mode_summary_on"
                app:summaryOff="@string/pref_motion_mode_summary_off"
                app:defaultValue="false" />

            <SwitchPreferenceCompat
                app:key="@string/pref_quiet_navigation_key"
                app:title="@string/pref_quiet_navigation_title"
                app:summaryOn="@string/pref_quiet_navigation_summary_on"
                app:summaryOff="@string/pref_quiet_navigation_summary_off"
                app:defaultValue="@bool/pref_quiet_navigation_default" />

        </PreferenceCategory>

    </PreferenceScreen>

    <!-- 分类入口 3：声音 -->
    <PreferenceScreen
        app:key="pref_category_sound"
        app:title="@string/pref_sound_category_title"
        app:summary="@string/pref_sound_category_summary">

        <SwitchPreferenceCompat
            app:key="@string/pref_sound_enabled_key"
            app:title="@string/pref_sound_enabled_title"
            app:summaryOn="@string/pref_sound_enabled_summary_on"
            app:summaryOff="@string/pref_sound_enabled_summary_off"
            app:defaultValue="true" />

        <Preference
            app:key="@string/pref_sound_volume_key"
            app:title="@string/pref_sound_volume_title"
            app:summary="@string/pref_sound_volume_summary" />

    </PreferenceScreen>

    <!-- 分类入口 4：高级 -->
    <PreferenceScreen
        app:key="@string/pref_category_miscellaneous_key"
        app:title="@string/pref_category_miscellaneous_title"
        app:summary="@string/pref_category_miscellaneous_summary">

        <Preference
            app:key="@string/pref_os_license_key"
            app:title="@string/pref_os_license_title" />

        <PreferenceScreen
            app:key="@string/pref_category_developer_key"
            app:title="@string/pref_category_developer_title"
            app:summary="@string/pref_category_developer_summary">

            <!-- Forced to VERBOSE in debug builds. -->
            <ListPreference
                app:key="@string/pref_log_level_key"
                app:title="@string/pref_log_level_label"
                app:dialogTitle="@string/pref_log_level_label"
                app:summary="%s"
                app:defaultValue="@string/pref_log_level_default"
                app:entries="@array/pref_log_level_entries"
                app:entryValues="@array/pref_log_level_values" />

            <Preference
                app:key="@string/pref_view_log_key"
                app:title="@string/pref_view_log_title"
                app:summary="@string/pref_view_log_summary" />

            <Preference
                app:key="@string/pref_share_log_key"
                app:title="@string/pref_share_log_title"
                app:summary="@string/pref_share_log_summary" />

            <Preference
                app:key="@string/pref_copy_log_key"
                app:title="@string/pref_copy_log_title"
                app:summary="@string/pref_copy_log_summary" />

            <Preference
                app:key="@string/pref_clear_log_key"
                app:title="@string/pref_clear_log_title"
                app:summary="@string/pref_clear_log_summary" />

            <PreferenceCategory
                app:key="@string/pref_category_braille_overlay_key"
                app:title="@string/pref_category_braille_overlay_title">

                <CheckBoxPreference
                    app:key="@string/pref_braille_overlay_key"
                    app:title="@string/pref_braille_overlay_title"
                    app:defaultValue="@bool/pref_braille_overlay_default" />

                <Preference
                    app:key="@string/pref_braille_overlay_tutorial_key"
                    app:title="@string/pref_braille_overlay_tutorial_title"
                    app:dependency="@string/pref_braille_overlay_key" />

            </PreferenceCategory>

        </PreferenceScreen>

    </PreferenceScreen>

</PreferenceScreen>
