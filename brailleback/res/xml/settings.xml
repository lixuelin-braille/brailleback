<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页（androidx.preference）：主屏只负责导航。

    信息架构：按「开始使用 / 设置分类 / 功能与内容」三个语义分组组织，设置分类下
    五个平级入口；五个子屏的内容全部由 compose 包下的独立 Activity 渲染，
    本文件不再定义任何子屏内容项（旧实现已归档，见 docs/归档-旧设置界面/）。

    兼容性约束：app:key（含 @string/pref_*_key 的实际取值）与迁移前完全一致，
    数据层共用同一个 SharedPreferences；不改动任何键名，老用户的设置不会丢失。
    偏好键本身由 res/values/donottranslate.xml 定义，删掉界面项不影响服务读取。
-->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ==================== 开始使用 ==================== -->
    <PreferenceCategory
        app:key="@string/pref_category_start_key"
        app:title="@string/pref_category_start_title">

        <!-- 启用服务引导：服务未启用时提示跳系统无障碍设置 -->
        <Preference
            app:key="@string/pref_setup_service_key"
            app:title="@string/pref_setup_service_title"
            app:summary="@string/pref_setup_service_summary" />

    </PreferenceCategory>

    <!-- ==================== 设置分类（五个平级子屏） ==================== -->
    <PreferenceCategory
        app:key="@string/pref_category_settings_key"
        app:title="@string/pref_category_settings_title">

        <!-- 五个子屏只保留入口行：内容全部由 compose 包下的独立 Activity 渲染，
             旧子屏定义归档在 docs/归档-旧设置界面/settings-legacy.xml。
             必须是 Preference 而不是空 PreferenceScreen：androidx 1.2.1 的
             PreferenceScreen.onClick() 在「无 intent、无 fragment、无子项」时会直接
             return，点击完全无反应（宁可静默失败也不抛异常，所以问题不易察觉）；
             同时 PreferenceScreen 覆写了 onClick，setOnPreferenceClickListener 对它无效。
             Preference 走默认 onClick，点击监听器才会被调用。 -->
        <Preference
            app:key="@string/pref_category_device_key"
            app:title="@string/pref_category_device_title"
            app:summary="@string/pref_category_device_summary" />

        <Preference
            app:key="@string/pref_category_keys_key"
            app:title="@string/pref_category_keys_title"
            app:summary="@string/pref_category_keys_summary" />

        <Preference
            app:key="@string/pref_category_braille_key"
            app:title="@string/pref_category_braille_title"
            app:summary="@string/pref_category_braille_summary" />

        <Preference
            app:key="@string/pref_category_sound_behavior_key"
            app:title="@string/pref_category_sound_behavior_title"
            app:summary="@string/pref_category_sound_behavior_summary" />

        <Preference
            app:key="@string/pref_category_developer_key"
            app:title="@string/pref_category_developer_title"
            app:summary="@string/pref_category_developer_summary" />

    </PreferenceCategory>

    <!-- ==================== 功能与内容（打开功能，不是设置开关） ==================== -->
    <PreferenceCategory
        app:key="@string/pref_category_features_key"
        app:title="@string/pref_category_features_title">

        <Preference
            app:key="@string/pref_bookshelf_key"
            app:title="@string/pref_bookshelf_title"
            app:summary="@string/pref_bookshelf_summary" />

        <!-- 屏幕盲文键盘（移植自 TalkBack）：点击进入键盘设置页 -->
        <Preference
            app:key="pref_braille_keyboard_key"
            app:title="@string/pref_braille_keyboard_title"
            app:summary="@string/pref_braille_keyboard_summary" />

        <Preference
            app:key="@string/pref_os_license_key"
            app:title="@string/pref_os_license_title"
            app:summary="@string/pref_os_license_summary" />

    </PreferenceCategory>

</PreferenceScreen>
