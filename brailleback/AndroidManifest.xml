<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.googlecode.eyesfree.brailleback"
      android:versionCode="33"
      android:versionName="0.98.0">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service keeps the braille display connection alive when
         the accessibility service would otherwise be idle-processed away.
         connectedDevice matches our use case (external braille displays). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required on API 33+ for the foreground-service notification to be
         visible. Without it the FGS still runs; only the notification is
         hidden (it remains in Task Manager). Requested at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ requires BLUETOOTH_CONNECT to enumerate bonded braille
         displays (DeviceFinder.getBondedDevices). BLUETOOTH_SCAN is not used:
         this app only connects to already-paired displays. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="com.googlecode.eyesfree.braille.display.PERMISSION_CONNECT" />

    <!-- Overlays are rendered as TYPE_ACCESSIBILITY_OVERLAY inside the
         accessibility service, which does not require SYSTEM_ALERT_WINDOW.
         The minSdk (23) is above the TYPE_SYSTEM_ERROR fallback path, so this
         permission was redundant and has been removed. -->

    <!-- Required for reading/writing custom view labels. -->
    <uses-permission android:name="com.google.android.marvin.talkback.permission.LABELING" />

    <permission
        android:name="com.googlecode.eyesfree.braille.display.PERMISSION_CONNECT"
        android:icon="@drawable/ic_brailleback"
        android:label="@string/permlab_displayConnect"
        android:description="@string/permdesc_displayConnect"
        android:protectionLevel="signature" />

    <!-- Hardware compatibility. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:label="@string/brailleback_setup_title"
        android:icon="@drawable/ic_brailleback"
        android:theme="@style/BraillebackTheme"
        tools:replace="android:icon, android:label"
        android:supportsRtl="true">

        <service android:name=".BrailleBackService"
                 android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
                 android:settingsActivity=".SettingsActivity"
                 android:foregroundServiceType="connectedDevice"
                 android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibilityservice" />
        </service>

        <service
            android:name=".BrailleIME"
            android:label="@string/braille_ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD" 
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name="com.googlecode.eyesfree.braille.service.display.DisplayService"
            android:permission="com.googlecode.eyesfree.braille.display.PERMISSION_CONNECT"
            android:exported="false">
            <intent-filter>
                <action android:name="com.googlecode.eyesfree.braille.service.ACTION_DISPLAY_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".SelfBrailleService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.googlecode.eyesfree.braille.service.ACTION_SELF_BRAILLE_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name="com.googlecode.eyesfree.braille.service.translate.TranslatorService"
            android:exported="false"
            android:process=":service">
            <intent-filter>
                <action android:name="com.googlecode.eyesfree.braille.service.ACTION_TRANSLATOR_SERVICE" />
            </intent-filter>
        </service>

        <!-- 设置页（androidx.preference 全量迁移）：桌面 + 无障碍服务设置入口。 -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/brailleback_setup_title"
            android:icon="@drawable/ic_brailleback"
            android:theme="@style/BraillebackSettingsTheme"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.accessibilityservice.SERVICE_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrailleReaderActivity"
            android:label="@string/pref_braille_reader_title"
            android:exported="false" />

        <activity
            android:name=".BookshelfActivity"
            android:label="@string/bookshelf_title"
            android:exported="false" />

        <activity
            android:name=".KeyBindingsActivity"
            android:title="@string/key_bindings_title"
            tools:ignore="ManifestResource"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
             android:name=".IMESetupWizardActivity"
             android:label="@string/ime_setup_wizard_name"
             android:theme="@android:style/Theme.Holo.Dialog"
             android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OverlayTutorialActivity"
            android:label="@string/overlay_tutorial_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- No intent-filter, so exported defaults to false. Stated explicitly
             to make the intent non-exported-by-design, and to avoid forgetting
             it should an intent-filter ever be added here. -->
        <activity android:name="WebViewDialog" android:exported="false" />

        <activity
            android:name=".SearchTutorialActivity"
            android:title="@string/search_tutorial_title"
            tools:ignore="ManifestResource"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
</application>
</manifest>

